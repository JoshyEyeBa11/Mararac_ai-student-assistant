# AI Student Assistant - backend environment configuration
# Copy this file to .env and fill in the values for YOUR AI provider.
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# SECURITY: .env is listed in .gitignore. Never commit the real key to GitHub.
# For submission, share only this .env.example with placeholder values.

PORT=5000

# --- OpenAI-compatible chat completions endpoint ---
# OpenAI:      https://api.openai.com/v1/chat/completions        (model: gpt-4o-mini)
# Groq:        https://api.groq.com/openai/v1/chat/completions   (model: llama-3.3-70b-versatile)
# OpenRouter:  https://openrouter.ai/api/v1/chat/completions     (model: openai/gpt-4o-mini)
# Together AI: https://api.together.xyz/v1/chat/completions      (model: meta-llama/Llama-3.3-70B-Instruct-Turbo)
# Ollama:      http://localhost:11434/v1/chat/completions        (model: llama3.1, key can be "ollama")
AI_API_URL=https://your-provider-api-endpoint/v1/chat/completions
AI_API_KEY=your-secret-api-key
AI_MODEL=your-configured-model
